// This source code is subject to the terms of the Mozilla Public License 2.0
// © tradingview-playbook
//@version=5
indicator("TPO Market Profile", shorttitle="TPO", overlay=true,
         max_boxes_count=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
i_period   = input.string("Day",  "Period",     options=["Day","Week","Month"],                  group="Profile")
i_blk      = input.string("30m",  "Block Size", options=["5m","10m","15m","30m","1h","2h","4h"],  group="Profile")
i_row_mode = input.string("Auto", "Row Size",   options=["Auto","Manual"],                        group="Profile")
i_ticks_m  = input.int(85,  "Ticks Per Row (Manual)", minval=1,                                  group="Profile")
i_va_pct   = input.float(70,"Value Area %", minval=1, maxval=100, step=1,                         group="Profile")
i_ib_n     = input.int(2,   "Initial Balance Blocks",  minval=1, maxval=10,                      group="Profile")
i_n_sess   = input.int(3,   "Sessions to Show",        minval=1, maxval=5,                       group="Profile")
i_merge    = input.bool(false, "Merge with Previous Session",                                     group="Profile")

i_poc      = input.bool(true,  "POC Line",              group="Lines")
i_poc_ext  = input.bool(true,  "Extend POC Right",       group="Lines")
i_vah      = input.bool(false, "VAH Line",              group="Lines")
i_val      = input.bool(false, "VAL Line",              group="Lines")
i_ibr      = input.bool(true,  "Initial Balance Range", group="Lines")
i_poor     = input.bool(true,  "Poor High / Low",       group="Lines")
i_mid      = input.bool(false, "TPO Midpoint",          group="Lines")
i_naked    = input.bool(true,  "Unmitigated POC Lines", group="Lines")

c_va      = input.color(color.new(#2196F3, 40), "Value Area",        group="Colors")
c_out     = input.color(color.new(#9E9E9E, 70), "Outside VA",        group="Colors")
c_poc_c   = input.color(color.white,            "POC Line",          group="Colors")
c_poor_c  = input.color(color.purple,           "Poor H/L",          group="Colors")
c_vah_c   = input.color(color.green,            "VAH",               group="Colors")
c_val_c   = input.color(color.red,              "VAL",               group="Colors")
c_ibr_c   = input.color(color.orange,           "IBR",               group="Colors")
c_mid_c   = input.color(color.new(color.white, 60), "Midpoint",      group="Colors")
c_naked_c = input.color(color.new(#FFD700, 60), "Unmitigated POC",   group="Colors")
c_merge_c = input.color(color.new(#00BCD4, 50), "Merged Profile VA", group="Colors")

// ═══════════════════════════════════════════════════════════════════════════════
// BLOCK SIZE → MILLISECONDS
// ═══════════════════════════════════════════════════════════════════════════════
blk_ms = switch i_blk
    "5m"  => 300000
    "10m" => 600000
    "15m" => 900000
    "1h"  => 3600000
    "2h"  => 7200000
    "4h"  => 14400000
    =>       1800000

// ═══════════════════════════════════════════════════════════════════════════════
// AUTO ROW SIZE
// ═══════════════════════════════════════════════════════════════════════════════
_h300   = ta.highest(high, 300)
_l300   = ta.lowest(low,  300)
_rt     = (_h300 - _l300) / syminfo.mintick
_pref   = (_h300 + _l300) * 0.5
_rinc   = _pref >= 10000 ? 5000.0 : _pref >= 1000 ? 500.0 : _pref >= 100 ? 50.0 : 5.0
_atpr   = math.max(1.0, math.round(_rt / 80.0 / _rinc) * _rinc)
tpr     = i_row_mode == "Auto" ? _atpr : float(i_ticks_m)
row_sz  = tpr * syminfo.mintick

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION DETECTION
// ═══════════════════════════════════════════════════════════════════════════════
new_sess = switch i_period
    "Week"  => ta.change(time("W")) != 0
    "Month" => ta.change(time("M")) != 0
    =>         ta.change(time("D")) != 0

// ═══════════════════════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════════════════════
MAX_R     = 250
MAX_NAKED = 10   // max unmitigated POC lines tracked

// Current session
var int     s_bar  = na
var int     s_t    = na
var int     s_blk  = -1
var float   s_hi   = na
var float   s_lo   = na
var float   ib_hi  = na
var float   ib_lo  = na
var int     rn     = 0
var float[] rb = array.new_float(MAX_R, 0.0)
var int[]   tc = array.new_int  (MAX_R, 0)
var bool[]  bv = array.new_bool (MAX_R, false)
var int     n_drawn = 0

// Previous session (for composite merge)
var float[] prev_rb = array.new_float(MAX_R, 0.0)
var int[]   prev_tc = array.new_int  (MAX_R, 0)
var int     prev_rn = 0

// Draw array: either tc or tc + prev_tc (merge mode)
var int[]   draw_tc = array.new_int(MAX_R, 0)

// Naked (unmitigated) POC tracking
var float[] nk_price   = array.new_float(MAX_NAKED, na)
var int[]   nk_s_bar   = array.new_int  (MAX_NAKED, na)
var bool[]  nk_mit     = array.new_bool (MAX_NAKED, false)
var int[]   nk_mit_bar = array.new_int  (MAX_NAKED, na)
var line[]  nk_lines   = array.new<line>()

// Exposed values
var float poc_px = na
var float vah_px = na
var float val_px = na
var float mid_px = na
var float ibh_px = na
var float ibl_px = na

// Current session drawings
var box[]  cur_bx   = array.new<box>()
var line   cur_ploc = na
var line   cur_pvah = na
var line   cur_pval = na
var line   cur_pibr = na
var line   cur_pmid = na
var box    cur_phi  = na
var box    cur_plo  = na

// ═══════════════════════════════════════════════════════════════════════════════
// HELPERS — parameterised so they work with any count array
// ═══════════════════════════════════════════════════════════════════════════════

get_poc_from(int[] arr, int n) =>
    int mx = 0
    int pi = 0
    for i = 0 to n - 1
        int c = array.get(arr, i)
        if c > mx
            mx := c
            pi := i
    pi

get_va_from(int[] arr, int n, int poc_i) =>
    int tot = 0
    for i = 0 to n - 1
        tot += array.get(arr, i)
    int tgt = int(math.floor(float(tot) * i_va_pct / 100.0))
    int acc = array.get(arr, poc_i)
    int vh  = poc_i
    int vl  = poc_i
    int g   = 0
    while acc < tgt and g < 500
        g += 1
        int ab = 0
        if vh + 1 < n
            ab += array.get(arr, vh + 1)
        if vh + 2 < n
            ab += array.get(arr, vh + 2)
        int bl = 0
        if vl - 1 >= 0
            bl += array.get(arr, vl - 1)
        if vl - 2 >= 0
            bl += array.get(arr, vl - 2)
        if ab == 0 and bl == 0
            break
        if ab >= bl
            vh  := math.min(n - 1, vh + (vh + 2 < n ? 2 : 1))
            acc += ab
        else
            vl  := math.max(0, vl - (vl - 2 >= 0 ? 2 : 1))
            acc += bl
    [vh, vl]

// ═══════════════════════════════════════════════════════════════════════════════
// ON NEW SESSION — STEP 1: DRAW COMPLETED SESSION + RECORD NAKED POC
// ═══════════════════════════════════════════════════════════════════════════════
if new_sess and not na(s_bar)

    // ── Save current session data as "previous" for next merge ───────
    prev_rn := rn
    for i = 0 to MAX_R - 1
        array.set(prev_rb, i, array.get(rb, i))
        array.set(prev_tc, i, array.get(tc, i))

    // ── Record this session's POC as a naked POC candidate ───────────
    int p_ri_nk = get_poc_from(tc, rn)
    float nk_p  = array.get(rb, p_ri_nk) + row_sz * 0.5
    int   e_bar_nk = bar_index - 1

    // Shift array right, insert at front (FIFO — keep newest at index 0)
    for i = MAX_NAKED - 1 to 1
        array.set(nk_price,   i, array.get(nk_price,   i - 1))
        array.set(nk_s_bar,   i, array.get(nk_s_bar,   i - 1))
        array.set(nk_mit,     i, array.get(nk_mit,     i - 1))
        array.set(nk_mit_bar, i, array.get(nk_mit_bar, i - 1))
    array.set(nk_price,   0, nk_p)
    array.set(nk_s_bar,   0, e_bar_nk)
    array.set(nk_mit,     0, false)
    array.set(nk_mit_bar, 0, na)

    // ── Draw completed session profile ───────────────────────────────
    if n_drawn < i_n_sess
        int  p_ri  = get_poc_from(tc, rn)
        [vh_ri, vl_ri] = get_va_from(tc, rn, p_ri)
        float p_px_  = array.get(rb, p_ri) + row_sz * 0.5
        float vh_px_ = array.get(rb, vh_ri) + row_sz
        float vl_px_ = array.get(rb, vl_ri)
        int   e_bar  = bar_index - 1
        int   elapsed = e_bar - s_bar + 1
        int   max_c  = 0
        for i = 0 to rn - 1
            if array.get(tc, i) > max_c
                max_c := array.get(tc, i)
        if max_c > 0
            for ri = 0 to rn - 1
                int cnt = array.get(tc, ri)
                if cnt > 0
                    float r_lo2 = array.get(rb, ri)
                    float r_hi2 = r_lo2 + row_sz
                    int w   = math.max(1, int(float(cnt) * float(elapsed) / float(max_c)))
                    int bxr = e_bar
                    int bxl = e_bar - w + 1
                    bool in_va  = ri >= vl_ri and ri <= vh_ri
                    color bclr  = in_va ? c_va : c_out
                    color bord  = ri == p_ri ? c_poc_c : color.new(color.black, 100)
                    int   bw    = ri == p_ri ? 1 : 0
                    box.new(bxl, r_hi2, bxr, r_lo2, bgcolor=bclr, border_color=bord, border_width=bw)
            if i_poc
                line.new(s_bar, p_px_, e_bar, p_px_, color=c_poc_c, width=1)
            if i_vah
                line.new(s_bar, vh_px_, e_bar, vh_px_, color=c_vah_c, width=1, style=line.style_dashed)
            if i_val
                line.new(s_bar, vl_px_, e_bar, vl_px_, color=c_val_c, width=1, style=line.style_dashed)
            if i_ibr and not na(ib_hi)
                line.new(s_bar, ib_hi, s_bar, ib_lo, color=c_ibr_c, width=3)
            if i_mid and not na(s_hi)
                line.new(s_bar, (s_hi+s_lo)*0.5, e_bar, (s_hi+s_lo)*0.5, color=c_mid_c, width=1, style=line.style_dotted)
            if i_poor
                int top_ri = -1
                for i = rn - 1 to 0
                    if array.get(tc, i) > 0
                        top_ri := i
                        break
                if top_ri >= 0 and array.get(tc, top_ri) == 1
                    float r_lo2 = array.get(rb, top_ri)
                    box.new(e_bar-1, r_lo2+row_sz, e_bar, r_lo2, bgcolor=color.new(c_poor_c,50), border_color=c_poor_c, border_width=1)
                int bot_ri = -1
                for i = 0 to rn - 1
                    if array.get(tc, i) > 0
                        bot_ri := i
                        break
                if bot_ri >= 0 and array.get(tc, bot_ri) == 1
                    float r_lo2 = array.get(rb, bot_ri)
                    box.new(e_bar-1, r_lo2+row_sz, e_bar, r_lo2, bgcolor=color.new(c_poor_c,50), border_color=c_poor_c, border_width=1)
        n_drawn += 1

// ═══════════════════════════════════════════════════════════════════════════════
// ON NEW SESSION — STEP 2: RESET STATE
// ═══════════════════════════════════════════════════════════════════════════════
if new_sess
    s_bar := bar_index
    s_t   := time
    s_blk := -1
    s_hi  := high
    s_lo  := low
    ib_hi := high
    ib_lo := low
    rn    := MAX_R
    float base = math.floor(open / row_sz) * row_sz - row_sz * 125.0
    for i = 0 to MAX_R - 1
        array.set(rb, i, base + row_sz * i)
        array.set(tc, i, 0)
        array.set(bv, i, false)
    poc_px := na
    vah_px := na
    val_px := na
    mid_px := na
    ibh_px := na
    ibl_px := na

// ═══════════════════════════════════════════════════════════════════════════════
// PER-BAR ACCUMULATION + NAKED POC MITIGATION CHECK
// ═══════════════════════════════════════════════════════════════════════════════
if not na(s_bar)
    s_hi := math.max(s_hi, high)
    s_lo := math.min(s_lo, low)

    int blk_now = int((time - s_t) / blk_ms)
    if blk_now != s_blk
        s_blk := blk_now
        for i = 0 to rn - 1
            array.set(bv, i, false)

    if s_blk < i_ib_n
        ib_hi := math.max(ib_hi, high)
        ib_lo := math.min(ib_lo, low)

    float base0 = array.get(rb, 0)
    int lo_ri = math.max(0,    int(math.floor((low  - base0) / row_sz)))
    int hi_ri = math.min(rn-1, int(math.floor((high - base0) / row_sz)))
    for ri = lo_ri to hi_ri
        if not array.get(bv, ri)
            array.set(tc, ri, array.get(tc, ri) + 1)
            array.set(bv, ri, true)

    // Mark naked POCs as mitigated when price trades through them
    if i_naked
        for i = 0 to MAX_NAKED - 1
            float nkp = array.get(nk_price, i)
            if not na(nkp) and not array.get(nk_mit, i)
                if high >= nkp and low <= nkp
                    array.set(nk_mit,     i, true)
                    array.set(nk_mit_bar, i, bar_index)

// ═══════════════════════════════════════════════════════════════════════════════
// DRAW CURRENT SESSION + NAKED POC LINES  (on last bar only)
// ═══════════════════════════════════════════════════════════════════════════════
if barstate.islast and not na(s_bar)

    // ── Delete current session drawings ──────────────────────────────
    for b in cur_bx
        box.delete(b)
    array.clear(cur_bx)
    line.delete(cur_ploc)
    line.delete(cur_pvah)
    line.delete(cur_pval)
    line.delete(cur_pibr)
    line.delete(cur_pmid)
    box.delete(cur_phi)
    box.delete(cur_plo)
    cur_ploc := na
    cur_pvah := na
    cur_pval := na
    cur_pibr := na
    cur_pmid := na
    cur_phi  := na
    cur_plo  := na

    // ── Build draw_tc: merge current + previous session if enabled ────
    //    For each row in current session grid, look up matching price row
    //    in the previous session and add its count.
    float cur_base0 = array.get(rb, 0)
    for ri = 0 to rn - 1
        int cur_cnt = array.get(tc, ri)
        int add_cnt = 0
        if i_merge and prev_rn > 0
            float row_price  = array.get(rb, ri)
            float prev_base0 = array.get(prev_rb, 0)
            int   prev_ri    = int(math.round((row_price - prev_base0) / row_sz))
            if prev_ri >= 0 and prev_ri < prev_rn
                add_cnt := array.get(prev_tc, prev_ri)
        array.set(draw_tc, ri, cur_cnt + add_cnt)

    // ── Recalculate POC / VA using draw_tc ───────────────────────────
    int p_ri   = get_poc_from(draw_tc, rn)
    [vh_ri, vl_ri] = get_va_from(draw_tc, rn, p_ri)

    poc_px := array.get(rb, p_ri) + row_sz * 0.5
    vah_px := array.get(rb, vh_ri) + row_sz
    val_px := array.get(rb, vl_ri)
    mid_px := (s_hi + s_lo) * 0.5
    ibh_px := ib_hi
    ibl_px := ib_lo

    int elapsed = bar_index - s_bar + 1
    int max_c   = 0
    for i = 0 to rn - 1
        if array.get(draw_tc, i) > max_c
            max_c := array.get(draw_tc, i)

    if max_c > 0
        // ── TPO boxes ────────────────────────────────────────────────
        //    Merged rows get a different VA color to signal composite profile
        for ri = 0 to rn - 1
            int cnt     = array.get(draw_tc, ri)
            int cur_cnt = array.get(tc, ri)
            if cnt > 0
                float r_lo2 = array.get(rb, ri)
                float r_hi2 = r_lo2 + row_sz
                int w   = math.max(1, int(float(cnt) * float(elapsed) / float(max_c)))
                int bxr = bar_index
                int bxl = bar_index - w + 1
                bool in_va    = ri >= vl_ri and ri <= vh_ri
                bool is_merge = i_merge and cur_cnt < cnt  // this row has prev-session contribution
                color bclr    = in_va ? (is_merge ? c_merge_c : c_va) : c_out
                color bord    = ri == p_ri ? c_poc_c : color.new(color.black, 100)
                int   bw      = ri == p_ri ? 1 : 0
                box b = box.new(bxl, r_hi2, bxr, r_lo2, bgcolor=bclr, border_color=bord, border_width=bw)
                array.push(cur_bx, b)

        // ── POC line ─────────────────────────────────────────────────
        if i_poc
            cur_ploc := line.new(s_bar, poc_px, bar_index, poc_px, color=c_poc_c, width=1,
                                extend=i_poc_ext ? extend.right : extend.none)

        // ── VAH / VAL ────────────────────────────────────────────────
        if i_vah
            cur_pvah := line.new(s_bar, vah_px, bar_index, vah_px, color=c_vah_c, width=1, style=line.style_dashed)
        if i_val
            cur_pval := line.new(s_bar, val_px, bar_index, val_px, color=c_val_c, width=1, style=line.style_dashed)

        // ── IBR ───────────────────────────────────────────────────────
        if i_ibr and not na(ib_hi)
            cur_pibr := line.new(s_bar, ib_hi, s_bar, ib_lo, color=c_ibr_c, width=3)

        // ── Midpoint ──────────────────────────────────────────────────
        if i_mid
            cur_pmid := line.new(s_bar, mid_px, bar_index, mid_px, color=c_mid_c, width=1, style=line.style_dotted)

        // ── Poor High ─────────────────────────────────────────────────
        if i_poor
            int top_ri = -1
            for i = rn - 1 to 0
                if array.get(draw_tc, i) > 0
                    top_ri := i
                    break
            if top_ri >= 0 and array.get(draw_tc, top_ri) == 1
                float r_lo2 = array.get(rb, top_ri)
                cur_phi := box.new(bar_index-1, r_lo2+row_sz, bar_index, r_lo2,
                                  bgcolor=color.new(c_poor_c,50), border_color=c_poor_c, border_width=1)
                array.push(cur_bx, cur_phi)

        // ── Poor Low ──────────────────────────────────────────────────
        if i_poor
            int bot_ri = -1
            for i = 0 to rn - 1
                if array.get(draw_tc, i) > 0
                    bot_ri := i
                    break
            if bot_ri >= 0 and array.get(draw_tc, bot_ri) == 1
                float r_lo2 = array.get(rb, bot_ri)
                cur_plo := box.new(bar_index-1, r_lo2+row_sz, bar_index, r_lo2,
                                  bgcolor=color.new(c_poor_c,50), border_color=c_poor_c, border_width=1)
                array.push(cur_bx, cur_plo)

    // ── Naked (Unmitigated) POC Lines ────────────────────────────────
    //    Delete old naked lines and redraw so right endpoint stays current
    if i_naked
        for l in nk_lines
            line.delete(l)
        array.clear(nk_lines)

        for i = 0 to MAX_NAKED - 1
            float nkp   = array.get(nk_price, i)
            int   nk_sb = array.get(nk_s_bar, i)
            if na(nkp) or na(nk_sb)
                continue
            bool  mitigated = array.get(nk_mit, i)
            int   mit_bar   = array.get(nk_mit_bar, i)

            // Skip POC if it matches the current session's live POC
            // (it's the same level, already shown by the POC line)
            if math.abs(nkp - poc_px) < row_sz * 0.5
                continue

            int line_end = mitigated ? mit_bar : bar_index
            line l = line.new(nk_sb, nkp, line_end, nkp,
                             color    = mitigated ? color.new(c_naked_c, 85) : c_naked_c,
                             width    = 1,
                             style    = line.style_dashed,
                             extend   = mitigated ? extend.none : extend.right)
            array.push(nk_lines, l)

// ═══════════════════════════════════════════════════════════════════════════════
// PLOT OUTPUTS — MCP-readable via data_get_study_values
// ═══════════════════════════════════════════════════════════════════════════════
plot(poc_px, "POC",          color=c_poc_c,   display=display.data_window)
plot(vah_px, "VAH",          color=c_vah_c,   display=display.data_window)
plot(val_px, "VAL",          color=c_val_c,   display=display.data_window)
plot(mid_px, "TPO Midpoint", color=c_mid_c,   display=display.data_window)
plot(ibh_px, "IB High",      color=c_ibr_c,   display=display.data_window)
plot(ibl_px, "IB Low",       color=c_ibr_c,   display=display.data_window)
